#!/bin/sh
# Root-owned wrapper (installed at /usr/local/bin/rb-run): lets the sandboxed agent user run pytest in a network-less container.
# The agent controls only pytest arguments and the working directory under /srv/agentwork.
d=$(realpath "$PWD")
case "$d" in /srv/agentwork/*) ;; *) echo "rb-run: bad dir" >&2; exit 2;; esac
img=$(cat "$d/.rbimage" 2>/dev/null)
case "$img" in rb-*) ;; *) echo "rb-run: bad image" >&2; exit 2;; esac
exec timeout 300 docker run --rm --network none --memory 2g --cpus 1 --pids-limit 512 -v "$d":/w -w /w \
  -e PYTHONPATH=/w:/w/src -e PYTHONDONTWRITEBYTECODE=1 "$img" python -m pytest -q -p no:cacheprovider --no-header "$@"
